{
  "name": "artificial-studio-pm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "test:rls": "docker exec -i supabase_db_artificial-studio-pm psql -U postgres -d postgres -q -f - < supabase/tests/rls_test.sql",
    "test:outbox": "docker exec -i supabase_db_artificial-studio-pm psql -U postgres -d postgres -q -f - < supabase/tests/outbox_test.sql",
    "test:bugfix": "docker exec -i supabase_db_artificial-studio-pm psql -U postgres -d postgres -q -f - < supabase/tests/bugfix_test.sql",
    "test:storage": "node supabase/tests/storage_test.mjs",
    "test:delivery": "node supabase/tests/outbox_delivery_test.mjs",
    "test:access": "node supabase/tests/access_test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@supabase/cli-windows-x64": "^2.115.0"
  }
}
