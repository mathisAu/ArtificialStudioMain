# Kopieer dit bestand naar .env.local en vul de waarden in.
# Alle waarden vind je in het Supabase-dashboard onder Project Settings → API.

# Project URL, bijvoorbeeld https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publieke sleutel (in nieuwere projecten "publishable key", voorheen "anon key").
# Deze staat in de browser en is veilig zolang RLS correct is ingesteld.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Geheime sleutel (voorheen "service_role key"). Omzeilt RLS volledig.
# Nodig om gebruikers en klanten uit te nodigen via de Auth Admin API.
# Deze mag NOOIT in de browser terechtkomen en niet in versiebeheer.
SUPABASE_SECRET_KEY=

# Basis-URL van de applicatie. Nodig voor de links in uitnodigings- en
# wachtwoordmails. Lokaal mag dit leeg blijven.
# NEXT_PUBLIC_SITE_URL=https://projecten.artificialstudio.nl

# Geheim waarmee een scheduler /api/uitgaand mag aanroepen om de wachtrij met
# uitgaande berichten te legen. Zonder deze waarde staat het endpoint uit.
OUTBOX_SECRET=

# API-sleutel van de mailprovider (Resend). Zonder sleutel blijven
# e-mailberichten in de wachtrij staan en worden ze overgeslagen.
# RESEND_API_KEY=

# API-sleutel van Chatlevel (WhatsApp). Zonder sleutel blijven
# WhatsApp-berichten in de wachtrij staan en worden ze overgeslagen. Het
# device-ID en of dit kanaal aan staat, wordt beheerd via app_settings.
# CHATLEVEL_API_KEY=
